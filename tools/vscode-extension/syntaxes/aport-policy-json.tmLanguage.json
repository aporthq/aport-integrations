{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "APort Policy JSON",
  "scopeName": "source.aport-policy.json",
  "patterns": [
    {
      "include": "source.json"
    },
    {
      "name": "constant.language.aport.policy-id",
      "match": "\\b[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+\\.v[0-9]+\\b"
    },
    {
      "name": "keyword.control.aport.effect",
      "match": "\\b(allow|deny|review)\\b"
    }
  ]
}
