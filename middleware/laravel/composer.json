{
    "name": "aport/aport-laravel",
    "description": "Laravel middleware for APort agent verification and policy enforcement",
    "type": "library",
    "license": "MIT",
    "keywords": ["aport", "laravel", "middleware", "agent", "policy"],
    "require": {
        "php": "^8.1",
        "illuminate/http": "^9.0|^10.0|^11.0",
        "illuminate/support": "^9.0|^10.0|^11.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0",
        "phpunit/phpunit": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Aport\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aport\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aport\\Laravel\\AportLaravelServiceProvider"
            ],
            "aliases": {
                "Aport": "Aport\\Laravel\\Facades\\Aport"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
