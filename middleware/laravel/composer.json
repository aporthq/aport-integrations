{
  "name": "aport/aport-laravel",
  "description": "Laravel middleware for APort agent identity verification and policy enforcement",
  "type": "library",
  "require": {
    "php": ">=8.1",
    "illuminate/http": "^10.0|^11.0",
    "illuminate/support": "^10.0|^11.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0",
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {"Aport\\Laravel\\": "src/"}
  },
  "autoload-dev": {
    "psr-4": {"Aport\\Laravel\\Tests\\": "tests/"}
  },
