APORT_BASE_URL=https://aport.io
APORT_API_KEY=your_aport_api_key
APORT_POLICY_ID=enterprise.identity.federation.v1
APORT_TIMEOUT_SECONDS=10

# SPIRE agent Workload API socket. The go-spiffe library also reads this name.
SPIFFE_ENDPOINT_SOCKET=unix:///tmp/spire-agent/public/api.sock

# Optional guardrail: reject workloads outside this trust domain before APort is called.
SPIFFE_TRUST_DOMAIN=example.org
