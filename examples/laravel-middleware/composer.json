{
    "name": "aport/laravel",
    "description": "APort verification middleware for Laravel",
    "type": "laravel-package",
    "license": "MIT",
    "authors": [
        {
            "name": "APort Team",
            "email": "hello@aport.io"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "laravel/framework": "^8.0|^9.0|^10.0|^11.0",
        "guzzlehttp/guzzle": "^6.5|^7.0"
    },
    "autoload": {
        "psr-4": {
            "APort\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "APort\\Laravel\\APortServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
