# GitHub App Configuration
# App ID (from GitHub App settings page)
GITHUB_APP_ID=your_github_app_id_here

# GitHub App Private Key (PEM format, base64-encoded or raw)
# Generate from: GitHub App settings > Private keys > Generate a private key
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# GitHub App Webhook Secret (for payload signature verification)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Server port for the webhook receiver
PORT=3000

# APort API Configuration
APORT_API_KEY=your_aport_api_key_here
APORT_BASE_URL=https://aport.io

# Default policy pack for PR verification
# Supported: code.repository.merge.v1, admin.access.v1, etc.
DEFAULT_POLICY_PACK=code.repository.merge.v1

# Logging level: debug, info, warn, error
LOG_LEVEL=info
